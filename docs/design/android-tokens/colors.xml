<?xml version="1.0" encoding="utf-8"?>
<!--
    Pulverfass · Color Tokens
    ==========================
    Single source of truth für alle Farben in der App.
    Generiert aus der Art Bible (Sprint 2).

    Alle Farben sind als Tokens benannt — niemals direkt aus Layouts
    auf Hex-Werte zugreifen. Stattdessen via:
        ?attr/colorPrimary  (für Theme-Attributes)
        @color/gold         (für direkte Token-Referenz)
-->
<resources>

