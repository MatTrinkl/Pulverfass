<configuration>
    <define name="LOG_DIR" class="at.aau.pulverfass.server.logging.RepositoryLogDirectoryPropertyDefiner"/>

    <appender class="ch.qos.logback.core.ConsoleAppender" name="STDOUT">
        <encoder>
            <pattern>%-5level %logger{0} | %msg | %d{yyyy-MM-dd HH:mm:ss.SSS}%n%ex{short}</pattern>
        </encoder>
    </appender>

    <appender class="ch.qos.logback.core.FileAppender" name="TECHNICAL_FILE">
        <file>${LOG_DIR}/technical-log.log</file>
        <append>false</append>
        <encoder>
            <pattern>%-5level %logger{0} | %msg | %d{yyyy-MM-dd HH:mm:ss.SSS}%n%ex{short}</pattern>
        </encoder>
    </appender>

    <appender class="ch.qos.logback.core.FileAppender" name="EVENT_FILE">
        <file>${LOG_DIR}/event-log.log</file>
        <append>true</append>
        <encoder>
            <pattern>%-5level %logger{0} | %msg | %d{yyyy-MM-dd HH:mm:ss.SSS}%n%ex{short}</pattern>
        </encoder>
    </appender>

    <logger name="at.aau.pulverfass.server.technical" level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="TECHNICAL_FILE"/>
    </logger>

    <logger name="at.aau.pulverfass.server.event" level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="EVENT_FILE"/>
    </logger>

    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="TECHNICAL_FILE"/>
    </root>
</configuration>
